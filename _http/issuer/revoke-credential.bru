meta {
  name: Revoke credential
  type: http
  seq: 10
}

post {
  url: {{issuerMgmtUrl}}/v1/credentials/{{credentialIdToRevoke}}/revoke
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Revokes an issued credential: its bit in the status list is set and the list is
  signed again. It cannot be undone. Nothing saves credentialIdToRevoke: copy an id
  from "List issued credentials" into that variable yourself, because a participant
  whose MembershipCredential is revoked is refused on every DSP request (within the
  verifier's status list cache time). 204 also when it was revoked before; 404 for an
  unknown id.
}
