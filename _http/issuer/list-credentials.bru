meta {
  name: List issued credentials
  type: http
  seq: 2
}

get {
  url: {{issuerMgmtUrl}}/v1/credentials
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Every credential issued, newest first, with its holder, status list index and
  delivery state; add ?holder=<DID> for one holder. Revoke one with "Revoke credential".
}
