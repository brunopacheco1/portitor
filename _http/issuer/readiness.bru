meta {
  name: Readiness
  type: http
  seq: 4
}

get {
  url: {{issuerMgmtUrl}}/api/check/readiness
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.isSystemHealthy: eq true
}

docs {
  ADR 0023: readiness of the issuer, from its own dependencies only: database (SQLite
  file), key (loaded and signs) and status-lists (both served and signed). 503 with the
  failing component and why when one fails. No API key.
}
