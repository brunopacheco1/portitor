meta {
  name: 5. Counter request (400 unless OFFERED)
  type: http
  seq: 5
}

post {
  url: {{dsp}}/negotiations/{{providerPid}}/request
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
    "@type": "ContractRequestMessage",
    "providerPid": "{{providerPid}}",
    "consumerPid": "{{consumerPid}}",
    "offer": {
      "@id": "{{offerId}}",
      "@type": "Offer",
      "target": "{{datasetId}}",
      "permission": [{"action": "use"}]
    }
  }
}

assert {
  res.status: eq 400
  res.body["@type"]: eq ContractNegotiationError
}

docs {
  DSP 2025-1 Contract Negotiation, HTTPS binding: POST /negotiations/:providerPid/request,
  the consumer's answer to a provider's offer. It fits the state OFFERED only (then: 200,
  state REQUESTED). This provider agrees to a catalog offer at once and never sends an
  offer of its own, so here the answer is 400 (invalid transition). The consumerPid must
  be the one the negotiation was started with, or the answer is 400 too (0.12).
}
