meta {
  name: 2. Negotiation state
  type: http
  seq: 2
}

get {
  url: {{dsp}}/negotiations/{{providerPid}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body["@type"]: eq ContractNegotiation
}

docs {
  DSP 2025-1 Contract Negotiation, HTTPS binding: GET /negotiations/:providerPid.
  Expect state AGREED once the provider has sent the agreement to the callback. Only
  the consumer that started the negotiation may read it; anyone else gets 404.
}
