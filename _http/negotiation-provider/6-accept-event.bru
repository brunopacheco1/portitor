meta {
  name: 6. Accepted event (400 unless OFFERED)
  type: http
  seq: 6
}

post {
  url: {{dsp}}/negotiations/{{providerPid}}/events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
    "@type": "ContractNegotiationEventMessage",
    "providerPid": "{{providerPid}}",
    "consumerPid": "{{consumerPid}}",
    "eventType": "ACCEPTED"
  }
}

assert {
  res.status: eq 400
  res.body["@type"]: eq ContractNegotiationError
}

docs {
  DSP 2025-1 Contract Negotiation, HTTPS binding: POST /negotiations/:providerPid/events,
  with which the consumer accepts a provider's offer. It fits the state OFFERED only
  (then: 200, state ACCEPTED). This provider never sends an offer of its own, so here
  the answer is 400 (invalid transition).
}
