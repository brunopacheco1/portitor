meta {
  name: Request credentials from the issuer
  type: http
  seq: 2
}

post {
  url: {{identityMgmtUrl}}/v1/credential-requests
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "issuerDid": "{{issuerDid}}",
    "credentialIds": ["membership-vc20"]
  }
}

script:post-response {
  if (res.body && res.body.holderPid) {
    bru.setVar("holderPid", res.body.holderPid);
  }
}

assert {
  res.status: eq 201
}

docs {
  The identity asks the issuer (DCP CredentialRequestMessage); the issuer decides in the
  background and delivers to the identity's Storage API. Saves holderPid. The issuer
  allows a limited number of active credentials per holder
  (PORTITOR_ISSUER_MAX_ACTIVE_PER_HOLDER), so a repeat may be REJECTED.
}
