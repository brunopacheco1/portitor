meta {
  name: Get credential request
  type: http
  seq: 3
}

get {
  url: {{identityMgmtUrl}}/v1/credential-requests/{{holderPid}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Run "Request credentials from the issuer" first: it saves holderPid.
  status is the identity's own state: REQUESTED until the issuer delivers, then ISSUED
  or REJECTED. issuerStatus is what the issuer says when asked now (DCP 6.8): RECEIVED,
  then ISSUED or REJECTED; issuerStatusError says why it could not be read.
}
