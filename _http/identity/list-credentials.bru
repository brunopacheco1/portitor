meta {
  name: List credentials
  type: http
  seq: 1
}

get {
  url: {{identityMgmtUrl}}/v1/credentials
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  The credentials this identity holds (id, types, issuer, profile, expiry), such as the
  MembershipCredential that scripts/dev-identities.sh asked for.
}
