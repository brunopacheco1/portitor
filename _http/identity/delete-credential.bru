meta {
  name: Delete credential
  type: http
  seq: 12
}

delete {
  url: {{identityMgmtUrl}}/v1/credentials/{{credentialIdToDelete}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 204
}

docs {
  Deletes a credential this identity holds. Nothing saves credentialIdToDelete: copy an
  id from "List credentials" into that variable yourself, because without its
  MembershipCredential the participant is refused on every DSP request. To get one
  again, run "Request credentials from the issuer". 404 for an unknown id.
}
