meta {
  name: List credential requests
  type: http
  seq: 9
}

get {
  url: {{identityMgmtUrl}}/v1/credential-requests
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body: isArray
}

docs {
  Every credential request of this identity, newest first, with its own state
  (REQUESTED, ISSUED or REJECTED). The issuer is not asked here; "Get credential
  request" does that for one request.
}
