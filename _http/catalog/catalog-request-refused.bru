meta {
  name: Catalog request, refused caller (401)
  type: http
  seq: 5
}

post {
  url: {{dsp}}/catalog/request
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "@context": ["https://w3id.org/dspace/2025/1/context.jsonld"],
    "@type": "CatalogRequestMessage"
  }
}

script:pre-request {
  // Runs after the collection's script, so it replaces the good token with one the
  // provider refuses.
  req.setHeader("Authorization", "Bearer not-a-token");
}

assert {
  res.status: eq 401
  res.body["@type"]: eq CatalogError
}

docs {
  A caller the provider refuses (here: a token that is not one) gets 401 on the catalog
  endpoints, with a DSP CatalogError that says only "unauthorized" (ADR 0016). The
  reason is in the provider's log. On the negotiation and transfer endpoints the answer
  is 404, see "negotiation-provider/Negotiation state, refused caller (404)".
}
