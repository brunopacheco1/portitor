meta {
  name: Start transfer again
  type: http
  seq: 19
}

post {
  url: {{mgmtUrl}}/v1/transfers/{{mgmtTransferConsumerPid}}/start
  body: none
  auth: inherit
}

assert {
  res.status: eq 202
  res.body.consumerPid: isDefined
}

docs {
  Starts a SUSPENDED transfer again (added in 1.1), whichever party suspended it.
  This is the management API, not the DSP endpoint: it takes no body, and it answers
  202 with the transfer. The connector then sends the DSP TransferStartMessage (without
  a dataAddress) to the provider in the background; the state becomes STARTED once the
  provider acknowledges it, and the same token works again.
  400 when the transfer is not SUSPENDED or a message is still on its way; 404 for an
  unknown consumerPid.
}
