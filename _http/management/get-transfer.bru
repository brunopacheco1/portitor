meta {
  name: Get transfer
  type: http
  seq: 5
}

get {
  url: {{mgmtUrl}}/v1/transfers/{{mgmtTransferConsumerPid}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.body && res.body.dataAddress) {
    const address = res.body.dataAddress;
    bru.setVar("dataEndpoint", address.endpoint);
    const auth = (address.endpointProperties || []).find((p) => p.name === "authorization");
    if (auth) {
      bru.setVar("dataAuthorization", "Bearer " + auth.value);
    }
  }
}

assert {
  res.status: eq 200
}

docs {
  The consumer's management API (GET /v1/transfers/{consumerPid}), not the DSP endpoint
  GET /transfers/{providerPid}: the answer is a TransferView.
  Within a second the state is STARTED and the transfer holds the provider's data
  address (DSP 2025-1 DataAddress). Saves dataEndpoint and dataAuthorization ("Bearer "
  and the value of the endpoint property "authorization") for "data/Fetch data".
}
