meta {
  name: Get harvest job
  type: http
  seq: 9
}

get {
  url: {{mgmtUrl}}/v1/harvest-jobs/{{harvestJobId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

docs {
  Run "List harvest jobs" first: it saves harvestJobId.
  One run with its counts and the reasons a dataset was rejected (errors: at most the
  first 1000). 404 for an unknown id; only the last 100 runs are kept.
}
