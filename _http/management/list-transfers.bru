meta {
  name: List transfers
  type: http
  seq: 6
}

get {
  url: {{mgmtUrl}}/v1/transfers?limit=20
  body: none
  auth: inherit
}

params:query {
  limit: 20
}

assert {
  res.status: eq 200
}

docs {
  The transfers this connector runs as consumer, in consumerPid order: transfers and, on
  a full page, next (pass it as after). limit is 1 to 100.
}
