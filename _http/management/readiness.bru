meta {
  name: Readiness
  type: http
  seq: 13
}

get {
  url: {{mgmtUrl}}/api/check/readiness
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.isSystemHealthy: eq true
}

docs {
  ADR 0023: readiness of the connector, from its own dependencies only: database
  (SQLite file), harvest (the start harvest ran), bundle (when configured) and identity
  (its DID document resolves and its STS signs; checked at most every 30 s). 503 with
  the failing component and why when one fails. No API key.
}
