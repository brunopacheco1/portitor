meta {
  name: Start negotiation (as consumer)
  type: http
  seq: 1
}

post {
  url: {{mgmtUrl}}/v1/negotiations
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "providerAddress": "{{dsp}}",
    "providerId": "{{providerId}}",
    "datasetId": "{{datasetId}}",
    "offer": {
      "@id": "{{offerId}}",
      "@type": "Offer",
      "permission": [{"action": "use"}]
    }
  }
}

script:post-response {
  if (res.body && res.body.consumerPid) {
    bru.setVar("mgmtNegotiationConsumerPid", res.body.consumerPid);
  }
}

assert {
  res.status: eq 201
}

docs {
  Use the "two-connectors" environment (docs/TESTING.md, Two connectors).
  This is the consumer's management API, not the DSP endpoint POST /negotiations/request:
  the body is a StartNegotiation (providerAddress, providerId, datasetId, offer), not a
  ContractRequestMessage. The connector sends the DSP message to the provider in the
  background. The answer is 201 with the negotiation as the connector sees it
  (consumerPid, state REQUESTED, providerAddress, providerId, offer).
  The offer must be copied from the provider's catalog. Saves mgmtNegotiationConsumerPid.
}
