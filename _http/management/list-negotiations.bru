meta {
  name: List negotiations
  type: http
  seq: 3
}

get {
  url: {{mgmtUrl}}/v1/negotiations?limit=20
  body: none
  auth: inherit
}

params:query {
  limit: 20
}

assert {
  res.status: eq 200
}

docs {
  The negotiations this connector runs as consumer, in consumerPid order: negotiations
  and, on a full page, next (pass it as after). limit is 1 to 100.
}
