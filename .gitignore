/target
/dist
*.cdx.json

# SQLite files from local runs
*.db
*.db-shm
*.db-wal
__pycache__/

# VS Code: share debug configurations, tasks and recommended extensions;
# keep personal settings (for example lldb.cargo) out of git
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# what each scenario's run.sh writes into its run/: keys, secrets,
# test CAs, credentials, the authority's bundle
/scenarios/*/run/

# the EDC interop scenario's Gradle outputs
/scenarios/edc-interop/runtimes/**/build/
/scenarios/edc-interop/runtimes/.gradle/
