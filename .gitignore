/target
/dist
*.cdx.json

# SQLite files from local runs
*.db
*.db-shm
*.db-wal
__pycache__/

# VS Code: share debug configurations, tasks and recommended extensions;
# keep personal settings (for example lldb.cargo) out of git
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# the Compose demos' generated keys, secrets and authority site
# (scenarios/two-party/run.sh and scenarios/health-lu/run.sh write them)
/scenarios/two-party/run/
/scenarios/health-lu/run/

# the EDC interop test's generated keys, secrets and authority site
# (scripts/edc-interop.sh writes them), and its Gradle outputs
/interop/edc/run/
/interop/edc/runtimes/**/build/
/interop/edc/runtimes/.gradle/

# the Gaia-X end-to-end test's generated test CA, keys and credentials
# (scripts/gaiax-e2e.sh writes them)
/interop/gaiax/run/
